---
/**
 * @file Navbar.astro
 * @description Menú de navegación flotante estilo iOS Glassmorphism.
 * Incluye comportamiento Smart Nav (se oculta al bajar y reaparece al subir).
 */
---

<header 
  id="main-header" 
  class="fixed top-4 sm:top-6 left-1/2 -translate-x-1/2 z-50 w-auto max-w-[95vw] transition-all duration-300 ease-in-out"
>
  <nav class="inline-flex items-center gap-1 sm:gap-2 p-1.5 rounded-full bg-slate-950/40 backdrop-blur-xl backdrop-saturate-150 border border-white/10 shadow-[0_8px_32px_0_rgba(0,0,0,0.37)] transition-all duration-300 hover:border-white/20 whitespace-nowrap">
    
    <!-- Enlace 1: Inicio -->
    <a 
      href="#inicio" 
      class="px-2.5 sm:px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-mono text-slate-300 hover:text-cyan-400 hover:bg-white/5 transition-all duration-200 whitespace-nowrap"
    >
      <span class="hidden sm:inline">// </span>inicio
    </a>

    <!-- Enlace 2: Proyectos -->
    <a 
      href="#proyectos" 
      class="px-2.5 sm:px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-mono text-slate-300 hover:text-cyan-400 hover:bg-white/5 transition-all duration-200 whitespace-nowrap"
    >
      <span class="hidden sm:inline">// </span>proyectos
    </a>

    <!-- Enlace 3: Habilidades -->
    <a 
      href="#habilidades" 
      class="px-2.5 sm:px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-mono text-slate-300 hover:text-cyan-400 hover:bg-white/5 transition-all duration-200 whitespace-nowrap"
    >
      <span class="hidden sm:inline">// </span>habilidades
    </a>

    <!-- BOTÓN DE ENLACE AL CURRICULUM
    -- Separador sutil de cristal --
    <div class="w-px h-3.5 bg-white/10 mx-0.5 shrink-0" aria-hidden="true"></div>

    -- Botón CV --
    <a 
      href="/cv.pdf" 
      target="_blank" 
      rel="noopener noreferrer" 
      class="px-2.5 sm:px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-mono font-medium text-cyan-300 bg-cyan-950/40 border border-cyan-500/30 hover:bg-cyan-900/50 hover:border-cyan-400 transition-all duration-200 shadow-[0_0_12px_rgba(6,182,212,0.12)] shrink-0 whitespace-nowrap"
    >
      CV ↗
    </a>
     -->

  </nav>
</header>

<script>
  const setupSmartNav = () => {
    const header = document.getElementById('main-header');
    if (!header) return;

    let lastScrollY = window.scrollY;
    const threshold = 8; // Umbral mínimo de scroll en px para activar la animación

    window.addEventListener('scroll', () => {
      const currentScrollY = window.scrollY;
      const diff = currentScrollY - lastScrollY;

      // Si estamos en la zona superior de la página, mantener siempre visible
      if (currentScrollY < 40) {
        header.classList.remove('-translate-y-32', 'opacity-0', 'pointer-events-none');
        lastScrollY = currentScrollY;
        return;
      }

      // Evitar micro-desplazamientos
      if (Math.abs(diff) < threshold) return;

      if (diff > 0) {
        // Scroll HACIA ABAJO -> Ocultar la barra
        header.classList.add('-translate-y-32', 'opacity-0', 'pointer-events-none');
      } else {
        // Scroll HACIA ARRIBA -> Mostrar la barra
        header.classList.remove('-translate-y-32', 'opacity-0', 'pointer-events-none');
      }

      lastScrollY = currentScrollY;
    }, { passive: true });
  };

  // Inicialización directa al cargar el módulo y soporte para Astro View Transitions
  setupSmartNav();
  document.addEventListener('astro:page-load', setupSmartNav);
</script>