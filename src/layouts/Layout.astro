---
/**
 * @file Layout.astro
 * @description Componente de plantilla base (Root Layout). Define la estructura HTML5,
 * importación de tipografías globales (Space Grotesk & JetBrains Mono), animaciones
 * globales en CSS y la inicialización del fondo interactivo con particles.js.
 * 
 * @module Layouts/Layout
 * @exports Component
 */

import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
---

<!doctype html>
<html lang="es" class="scroll-smooth">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>Carlos Castañeda | Full Stack developer</title>
        
        <!-- Recurso tipográfico: Space Grotesk (Cuerpo) + JetBrains Mono (Consola/Code) -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link 
          href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Space+Grotesk:wght@400;500;600;700&display=swap" 
          rel="stylesheet"
        >
        
        <!-- Carga asíncrona de la librería oficial de particles.js por CDN seguro -->
        <script is:inline src="https://cdn.jsdelivr.net/particles.js/2.0.0/particles.min.js"></script>
    </head>
    <body class="bg-[#0b0c10] text-slate-100 min-h-screen antialiased relative selection:bg-cyan-500 selection:text-slate-950 font-sans">
        
        <!-- Navbar Flotante -->
        <Navbar />
        
        <!-- Contenedor del lienzo interactivo para el fondo de partículas -->
        <div id="particles-js" class="fixed inset-0 z-0 pointer-events-none" aria-hidden="true"></div>

        <!-- Capa contenedora del contenido visible principal -->
        <div class="relative z-10">
            <slot />
        </div>

        <!-- Script de inicialización: Preset NASA adaptado para captura de ventana global -->
        <script is:inline>
            const initParticles = () => {
                if (typeof particlesJS !== 'undefined') {
                    // Ajuste dinámico: 60 partículas en móviles, 160 en escritorio
                    const isMobile = window.innerWidth < 768;
                    const particleCount = isMobile ? 60 : 160;
                
                    particlesJS('particles-js', {
                        "particles": {
                            "number": { 
                                "value": particleCount, 
                                "density": { "enable": true, "value_area": 800 } 
                            },
                            "color": { "value": "#ffffff" },
                            "shape": { "type": "circle", "stroke": { "width": 0, "color": "#000000" } },
                            "opacity": { 
                                "value": 1, 
                                "random": true, 
                                "anim": { "enable": true, "speed": 1, "opacity_min": 0, "sync": false } 
                            },
                            "size": { "value": 3, "random": true, "anim": { "enable": false } },
                            "line_linked": { "enable": false },
                            "move": { 
                                "enable": true, 
                                "speed": 1, 
                                "direction": "none", 
                                "random": true, 
                                "straight": false, 
                                "out_mode": "out", 
                                "bounce": false 
                            }
                        },
                        "interactivity": {
                            "detect_on": "window",
                            "events": {
                                "onhover": { "enable": true, "mode": "bubble" },
                                "onclick": { "enable": true, "mode": "repulse" },
                                "resize": true
                            },
                            "modes": {
                                "bubble": { "distance": 250, "size": 0, "duration": 2, "opacity": 0, "speed": 3 },
                                "repulse": { "distance": 400, "duration": 0.4 }
                            }
                        },
                        "retina_detect": true
                    });
                }
            };
        
            // Inicialización segura tanto en carga directa como con Astro View Transitions
            if (document.readyState === 'complete' || document.readyState === 'interactive') {
                initParticles();
            } else {
                window.addEventListener('DOMContentLoaded', initParticles);
            }
            document.addEventListener('astro:page-load', initParticles);
        </script>
    </body>
</html>