---
/**
 * @file index.astro
 * @description Vista principal del portfolio personal (Landing Page). Renderiza las secciones
 * de Hero/Presentación, Proyectos Activos, Proyectos Concluidos, Habilidades Técnicas
 * y Pie de página con offset para navegación flotante.
 * 
 * @module Pages/Index
 * @requires Layout - Componente raíz de maquetación HTML.
 * @requires Card - Componente modular reusable para tarjetas de proyectos.
 */

import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SkillCard from "../components/SkillCard.astro";
---

<Layout>
  <!-- 
    ==========================================================================
    CONTENEDOR PRINCIPAL
    Con compensación superior (`pt-24 sm:pt-28`) para librar la navbar flotante.
    ==========================================================================
  -->
  <main class="max-w-6xl mx-auto px-4 pt-24 sm:pt-28 pb-16">
    
    <!-- 
      SECTION 1: HERO / PRESENTACIÓN
    -->
    <section id="inicio" class="mb-16 scroll-mt-28">
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-4 text-slate-100">
        ¡Hola, soy <span class="text-cyan-400">Carlos</span>, bienvenidos a mi portfolio!
      </h1>
      <p class="text-xl text-slate-300 leading-relaxed max-w-2xl">
        Desarrollador <strong class="text-slate-100">Full Stack</strong>. 
        Especializado en construir aplicaciones web integrales, diseñando APIs robustas, optimizando bases de datos y creando interfaces eficientes.
      </p>
    </section>

    <!-- 
      PROYECTOS (Agrupados bajo el mismo ID de navegación)
    -->
    <div id="proyectos" class="scroll-mt-28">
      
      <!-- SECTION 2: PROYECTOS ACTIVOS -->
      <section class="mb-16">
        <h2 class="text-xl font-mono text-cyan-400 mb-6 flex items-center gap-2 tracking-wide">
          <span aria-hidden="true"># //</span> MIS_PROYECTOS_ACTIVOS
        </h2>

        <div class="flex flex-col sm:flex-row gap-5 overflow-x-auto no-scrollbar py-6 -my-6 px-2 -mx-2 items-start">
          <ProjectCard 
            title="Deal Game Alert"
            description="Bot automatizado para la monitorización y notificación de ofertas de videojuegos en tiempo real."
            tags={["Python", "SQLite"]}
            githubUrl="https://github.com/Xolrak/Deal-Game-Alert"
            status="ACTIVO"
            animationDelay="100ms"
          />
        </div>
      </section>

      <!-- SECTION 3: PROYECTOS CONCLUIDOS -->
      <section class="mb-16">
        <h2 class="text-xl font-mono text-pink-500 mb-6 flex items-center gap-2 tracking-wide">
          <span aria-hidden="true"># //</span> PROYECTOS_CONCLUIDOS
        </h2>

        <div class="flex flex-col sm:flex-row gap-5 sm:overflow-x-auto py-6 -my-6 px-2 -mx-2 sm:scroll-smooth sm:snap-x sm:snap-mandatory items-start no-scrollbar">
          <ProjectCard 
            title="Roig Arena - Sistema de tickets"
            description="Proyecto hecho en el segundo curso de DAW para la simulación y gestión de compras de entradas."
            tags={["PHP/Laravel", "MySQL", "Docker"]}
            githubUrl="https://github.com/Xolrak/Roig-Arena"
            status="CONCLUIDO"
            animationDelay="200ms"
          />
          <ProjectCard 
            title="Smart Nav Scroll"
            description="Plugin para WordPress que oculta/muestra el menú según la dirección del scroll."
            tags={["WordPress", "JavaScript"]}
            githubUrl="https://github.com/Xolrak/Smart-Nav-Scroll"
            status="CONCLUIDO"
            animationDelay="300ms"
          />
          <ProjectCard 
            title="Feria VLC"
            description="Proyecto del primer curso de DAW para la gestión y consulta de eventos de la Feria de Valencia."
            tags={["Python", "MJML", "MySQL", "Docker"]}
            githubUrl="https://github.com/Xolrak/feria_vlc"
            status="CONCLUIDO"
            animationDelay="400ms"
          />
        </div>
      </section>

    </div>

    <!-- 
      SECTION 4: HABILIDADES TÉCNICAS
    -->
    <section id="habilidades" class="mb-16 scroll-mt-28">
      <h2 class="text-xl font-mono text-cyan-400 mb-6 flex items-center gap-2 tracking-wide">
        <span aria-hidden="true"># //</span> HABILIDADES_TECNICAS
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        <SkillCard 
          title="Backend"
          skills={["Python", "PHP / Laravel", "Java", "Scripting (Bash / PowerShell)"]}
          animationDelay="500ms"
        />

        <SkillCard 
          title="Bases de Datos"
          skills={["Relacionales: PostgreSQL / MySQL", "Embebidas: SQLite"]}
          animationDelay="600ms"
        />

        <SkillCard 
          title="DevOps & Tools"
          skills={["Docker / Contenedores", "Git / GitHub Actions", "Linux"]}
          animationDelay="700ms"
        />
      </div>
    </section>

    <!-- 
      SECTION 5: FOOTER
    -->
    <footer class="border-t border-white/10 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-slate-400 text-sm font-mono">
      <p>© {new Date().getFullYear()} Carlos. Todos los derechos reservados.</p>
      
      <div class="flex gap-6">
        <a href="https://github.com/Xolrak" target="_blank" rel="noopener noreferrer" class="hover:text-cyan-400 transition-colors">
          GitHub ↗
        </a>
        <a href="mailto:carloscasta.dev@gmail.com" class="hover:text-cyan-400 transition-colors">
          Email ↗
        </a>
      </div>
    </footer>

  </main>
</Layout>