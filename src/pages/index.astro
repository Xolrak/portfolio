---
/**
 * @file index.astro
 * @description Vista principal del portfolio personal (Landing Page). Renderiza las secciones
 * de Hero/Presentación, Proyectos Activos, Proyectos Concluidos (Carrusel), Habilidades Técnicas
 * y Pie de página con animación de entrada progresiva.
 * 
 * @module Pages/Index
 * @requires Layout - Componente raíz de maquetación HTML.
 */

import Layout from "../layouts/Layout.astro";
---

<Layout>
  <!-- 
    ==========================================================================
    CONTENEDOR PRINCIPAL
    Ancho máximo ajustado a ~1152px (`max-w-6xl`), centrado y con espaciado vertical.
    ==========================================================================
  -->
  <main class="max-w-6xl mx-auto px-4 py-16">
    
    <!-- 
      SECTION 1: HERO / PRESENTACIÓN
      Resumen del perfil profesional y tecnologías principales.
    -->
    <section class="mb-16">
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-4 text-slate-100">
        ¡Hola, soy <span class="text-cyan-400">Carlos</span>, bienvenidos a mi portfolio!
      </h1>
      <p class="text-xl text-slate-300 leading-relaxed max-w-2xl">
        Desarrollador <strong class="text-slate-100">Full Stack</strong>. 
        Especializado en construir aplicaciones web integrales, diseñando APIs robustas, optimizando bases de datos y creando interfaces eficientes.
      </p>
    </section>

    <!-- 
      SECTION 2: PROYECTOS ACTIVOS
      Contenedor sin scrollbar para evitar el desbordamiento vertical inicial.
    -->
    <section class="mb-16">
      <h2 class="text-xl font-mono text-cyan-400 mb-6 flex items-center gap-2 tracking-wide">
        <span aria-hidden="true"># //</span> MIS_PROYECTOS_ACTIVOS
      </h2>

      <div class="flex gap-5 overflow-hidden no-scrollbar pb-2 items-start">
        
        <!-- CARD: Deal Game Alert -->
        <article style="animation-delay: 100ms;" class="animate-cascade w-full sm:w-[calc(50%-10px)] lg:w-[calc(33.333%-14px)] min-w-75 bg-[#0d0d15] border border-cyan-500/50 rounded-xl p-5 sm:p-6 hover:border-cyan-400 transition-all flex flex-col justify-between relative overflow-hidden group shadow-lg shadow-cyan-950/30 shrink-0">
          <div>
            <div class="flex items-center justify-between mb-3">
              <h3 class="font-mono text-lg font-semibold text-slate-100 group-hover:text-cyan-300 transition-colors">
                Deal Game Alert
              </h3>
              <!-- Badge: Estado Activo (Cian Neón con Pulso Radar) -->
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-mono bg-cyan-950/40 text-cyan-300 border border-cyan-500/40 shadow-[0_0_10px_rgba(6,182,212,0.15)] uppercase tracking-wider">
                <span class="relative flex h-2 w-2" aria-hidden="true">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-400"></span>
                </span>
                ACTIVO
              </span>
            </div>
            <p class="text-slate-300 text-sm mb-5 leading-relaxed">
              Bot automatizado para la monitorización y notificación de ofertas de videojuegos en tiempo real.
            </p>
          </div>
          <div>
            <!-- Stack de Tecnologías -->
            <div class="flex flex-wrap gap-2 mb-5">
              <span class="text-xs font-mono bg-slate-900/90 text-cyan-300 px-2.5 py-1 rounded-md border border-slate-800">Python</span>
              <span class="text-xs font-mono bg-slate-900/90 text-cyan-300 px-2.5 py-1 rounded-md border border-slate-800">SQLite</span>
              <span class="text-xs font-mono bg-slate-900/90 text-cyan-300 px-2.5 py-1 rounded-md border border-slate-800">Automation</span>
            </div>
            <!-- Acciones -->
            <div class="flex gap-4 text-sm font-medium pt-2.5 border-t border-slate-800/80">
              <a href="https://github.com/Xolrak/Deal-Game-Alert" target="_blank" rel="noopener noreferrer" class="text-cyan-400 hover:text-cyan-300 transition-colors inline-flex items-center gap-1">
                Ver Código →
              </a>
            </div>
          </div>
        </article>

      </div>
    </section>

    <!-- 
      SECTION 3: PROYECTOS TERMINADOS / CONCLUIDOS
      Carrusel deslizable de 1 fila con encaje fluido de tarjetas.
    -->
    <section class="mb-16">
      <h2 class="text-xl font-mono text-pink-500 mb-6 flex items-center gap-2 tracking-wide">
        <span aria-hidden="true"># //</span> PROYECTOS_CONCLUIDOS
      </h2>

      <div class="flex gap-5 overflow-x-auto pb-4 scroll-smooth snap-x snap-mandatory items-start no-scrollbar">
        
        <!-- CARD 1: Roig Arena -->
        <article style="animation-delay: 200ms;" class="animate-cascade w-full sm:w-[calc(50%-10px)] lg:w-[calc(33.333%-14px)] min-w-75 bg-[#0d0d15] border border-slate-800 rounded-xl p-5 sm:p-6 hover:border-pink-500/60 transition-all flex flex-col justify-between shadow-lg shadow-cyan-950/10 group shrink-0 snap-start">
          <div>
            <div class="flex items-center justify-between mb-3">
              <h3 class="font-mono text-lg font-semibold text-slate-100 group-hover:text-pink-400 transition-colors">
                Roig Arena - Sistema de tickets
              </h3>
              <!-- Badge: Estado Concluido (Verde Esmeralda) -->
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-mono bg-emerald-950/40 text-emerald-300 border border-emerald-500/40 shadow-[0_0_10px_rgba(16,185,129,0.15)] uppercase tracking-wider">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-400" aria-hidden="true"></span>
                CONCLUIDO
              </span>
            </div>
            <p class="text-slate-300 text-sm mb-5 leading-relaxed">
              Proyecto hecho en el segundo curso de DAW para la simulación y gestión de compras de entradas.
            </p>
          </div>
          <div>
            <div class="flex flex-wrap gap-2 mb-5">
              <span class="text-xs font-mono bg-slate-900 text-slate-300 px-2.5 py-1 rounded-md border border-slate-800">PHP/Laravel</span>
              <span class="text-xs font-mono bg-slate-900 text-slate-300 px-2.5 py-1 rounded-md border border-slate-800">MySQL</span>
              <span class="text-xs font-mono bg-slate-900 text-slate-300 px-2.5 py-1 rounded-md border border-slate-800">Docker</span>
            </div>
            <div class="flex gap-4 text-sm font-medium pt-2.5 border-t border-slate-800/60">
              <a href="https://github.com/Xolrak/Roig-Arena" target="_blank" rel="noopener noreferrer" class="text-pink-400 hover:text-pink-300 transition-colors inline-flex items-center gap-1">
                Ver Código →
              </a>
            </div>
          </div>
        </article>

        <!-- CARD 2: Smart Nav Scroll -->
        <article style="animation-delay: 300ms;" class="animate-cascade w-full sm:w-[calc(50%-10px)] lg:w-[calc(33.333%-14px)] min-w-75 bg-[#0d0d15] border border-slate-800 rounded-xl p-5 sm:p-6 hover:border-pink-500/60 transition-all flex flex-col justify-between shadow-lg shadow-cyan-950/10 group shrink-0 snap-start">
          <div>
            <div class="flex items-center justify-between mb-3">
              <h3 class="font-mono text-lg font-semibold text-slate-100 group-hover:text-pink-400 transition-colors">
                Smart Nav Scroll
              </h3>
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-mono bg-emerald-950/40 text-emerald-300 border border-emerald-500/40 shadow-[0_0_10px_rgba(16,185,129,0.15)] uppercase tracking-wider">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-400" aria-hidden="true"></span>
                CONCLUIDO
              </span>
            </div>
            <p class="text-slate-300 text-sm mb-5 leading-relaxed">
              Plugin para WordPress que oculta/muestra el menú según la dirección del scroll.
            </p>
          </div>
          <div>
            <div class="flex flex-wrap gap-2 mb-5">
              <span class="text-xs font-mono bg-slate-900 text-slate-300 px-2.5 py-1 rounded-md border border-slate-800">WordPress</span>
              <span class="text-xs font-mono bg-slate-900 text-slate-300 px-2.5 py-1 rounded-md border border-slate-800">JavaScript</span>
            </div>
            <div class="flex gap-4 text-sm font-medium pt-2.5 border-t border-slate-800/60">
              <a href="https://github.com/Xolrak/Smart-Nav-Scroll" target="_blank" rel="noopener noreferrer" class="text-pink-400 hover:text-pink-300 transition-colors inline-flex items-center gap-1">
                Ver Código →
              </a>
            </div>
          </div>
        </article>

        <!-- CARD 3: Feria VLC -->
        <article style="animation-delay: 400ms;" class="animate-cascade w-full sm:w-[calc(50%-10px)] lg:w-[calc(33.333%-14px)] min-w-75 bg-[#0d0d15] border border-slate-800 rounded-xl p-5 sm:p-6 hover:border-pink-500/60 transition-all flex flex-col justify-between shadow-lg shadow-cyan-950/10 group shrink-0 snap-start">
          <div>
            <div class="flex items-center justify-between mb-3">
              <h3 class="font-mono text-lg font-semibold text-slate-100 group-hover:text-pink-400 transition-colors">
                Feria VLC
              </h3>
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-mono bg-emerald-950/40 text-emerald-300 border border-emerald-500/40 shadow-[0_0_10px_rgba(16,185,129,0.15)] uppercase tracking-wider">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-400" aria-hidden="true"></span>
                CONCLUIDO
              </span>
            </div>
            <p class="text-slate-300 text-sm mb-5 leading-relaxed">
              Proyecto del primer curso de DAW para la gestión y consulta de eventos de la Feria de Valencia.
            </p>
          </div>
          <div>
            <div class="flex flex-wrap gap-2 mb-5">
              <span class="text-xs font-mono bg-slate-900 text-slate-300 px-2.5 py-1 rounded-md border border-slate-800">Python</span>
              <span class="text-xs font-mono bg-slate-900 text-slate-300 px-2.5 py-1 rounded-md border border-slate-800">MJML</span>
              <span class="text-xs font-mono bg-slate-900 text-slate-300 px-2.5 py-1 rounded-md border border-slate-800">MySQL</span>
              <span class="text-xs font-mono bg-slate-900 text-slate-300 px-2.5 py-1 rounded-md border border-slate-800">Docker</span>
            </div>
            <div class="flex gap-4 text-sm font-medium pt-2.5 border-t border-slate-800/60">
              <a href="https://github.com/Xolrak/feria_vlc" target="_blank" rel="noopener noreferrer" class="text-pink-400 hover:text-pink-300 transition-colors inline-flex items-center gap-1">
                Ver Código →
              </a>
            </div>
          </div>
        </article>

      </div>
    </section>

    <!-- 
      SECTION 4: HABILIDADES TÉCNICAS
      Desglose categórico de aptitudes técnicas y stack de infraestructura/Backend.
    -->
    <section class="mb-16">
      <h2 class="text-xl font-mono text-cyan-400 mb-6 flex items-center gap-2 tracking-wide">
        <span aria-hidden="true"># //</span> HABILIDADES_TECNICAS
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        
        <!-- Categoría: Backend -->
        <div style="animation-delay: 500ms;" class="animate-cascade bg-[#0d0d15] border border-slate-800 rounded-xl p-5 sm:p-6">
          <h3 class="text-xs font-mono font-semibold text-cyan-400 uppercase tracking-wider mb-3"># Backend</h3>
          <ul class="text-slate-300 font-mono text-sm space-y-2">
            <li>• Python</li>
            <li>• PHP / Laravel</li>
            <li>• Java</li>
            <li>• Scripting (Bash / PowerShell)</li>
          </ul>
        </div>

        <!-- Categoría: Bases de Datos -->
        <div style="animation-delay: 600ms;" class="animate-cascade bg-[#0d0d15] border border-slate-800 rounded-xl p-5 sm:p-6">
          <h3 class="text-xs font-mono font-semibold text-cyan-400 uppercase tracking-wider mb-3"># Bases de Datos</h3>
          <ul class="text-slate-300 font-mono text-sm space-y-2">
            <li>• Relacionales: PostgreSQL / MySQL</li>
            <li>• Embebidas: SQLite</li>
          </ul>
        </div>

        <!-- Categoría: DevOps & Tools -->
        <div style="animation-delay: 700ms;" class="animate-cascade bg-[#0d0d15] border border-slate-800 rounded-xl p-5 sm:p-6">
          <h3 class="text-xs font-mono font-semibold text-cyan-400 uppercase tracking-wider mb-3"># DevOps & Tools</h3>
          <ul class="text-slate-300 font-mono text-sm space-y-2">
            <li>• Docker / Contenedores</li>
            <li>• Git / GitHub Actions</li>
            <li>• Linux</li>
          </ul>
        </div>

      </div>
    </section>

    <!-- 
      SECTION 5: FOOTER
      Pie de página con derechos de autor y enlaces directos de contacto.
    -->
    <footer class="border-t border-slate-800 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-slate-400 text-sm font-mono">
      <p>© {new Date().getFullYear()} Carlos. Todos los derechos reservados.</p>
      
      <div class="flex gap-6">
        <a href="https://github.com/Xolrak" target="_blank" rel="noopener noreferrer" class="hover:text-cyan-400 transition-colors">
          GitHub ↗
        </a>
        <a href="mailto:carloscasta.dev@gmail.com" class="hover:text-cyan-400 transition-colors">
          Email ↗
        </a>
      </div>
    </footer>

  </main>
</Layout>